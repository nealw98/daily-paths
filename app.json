{
  "expo": {
    "name": "Daily Paths",
    "slug": "daily-paths",
    "scheme": "dailypaths",
    "version": "3.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nealwagner.dailypaths",
      "buildNumber": "53",
      "appStoreUrl": "https://apps.apple.com/app/id6755981862",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.developer.icloud-container-environment": "Production",
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.nealwagner.dailypaths"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.nealwagner.dailypaths"
        ]
      }
    },
    "android": {
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FAFA"
      },
      "package": "com.nealw98.dailypaths",
      "versionCode": 53,
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.nealw98.dailypaths"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/round-splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7FAFA",
          "imageWidth": 100
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e915c97-57b3-4269-bbf3-6b382e0e8f39"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e915c97-57b3-4269-bbf3-6b382e0e8f39"
    }
  }
}
